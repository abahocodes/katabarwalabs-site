---
import Base from '../../layouts/Base.astro';
import { atlassianApps } from '../../data/atlassianApps';
import { collection, canonical } from '../../lib/seo';
const jsonLd = collection({ path: '/atlassian', name: 'Atlassian Marketplace apps by Katabarwa Labs', description: 'Governance, audit, and hygiene apps for Jira, Jira Service Management, and Confluence Cloud, all running on Atlassian Forge inside your own tenant.', items: atlassianApps.map((a) => ({ name: a.name, url: canonical(`/atlassian/${a.slug}`) })) });

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups: [string, string][] = [
  ['Jira', 'Access governance, audit retention, and license hygiene for Jira Cloud.'],
  ['Jira Service Management', 'Portal access, notification evidence, and Assets export for JSM.'],
  ['Confluence', 'Attachment storage and page-restriction governance for Confluence Cloud.'],
];
---
<Base
  title="Atlassian Marketplace apps by Katabarwa Labs | Jira, JSM, and Confluence admin tools"
  jsonLd={jsonLd}
  description="Eleven single-purpose governance and audit apps for Jira, Jira Service Management, and Confluence Cloud. All run entirely on Atlassian Forge inside your own tenant: no external servers, no data egress."
>
  <section class="bg-[linear-gradient(160deg,#0a1636,#152f6b)] text-[#eaf0ff]">
    <div class="wrap pt-[56px] pb-[52px]">
      <span class="eyebrow">Atlassian Marketplace</span>
      <h1 class="mt-3 max-w-[24ch] text-[clamp(28px,4.5vw,42px)] font-extrabold leading-[1.1] tracking-[-0.02em] text-white">
        Small apps that answer the questions Jira and Confluence cannot.
      </h1>
      <p class="mt-4 max-w-[62ch] text-[17px] leading-relaxed text-[#c8d6f7]">
        Governance, audit, and hygiene tools. Each one does a single job well, runs entirely on
        Atlassian Forge inside your own tenant, and exports audit-ready CSV. No external servers,
        no data egress.
      </p>
    </div>
  </section>

  {groups.map(([product, blurb]) => (
    <section class="wrap pt-12 last-of-type:pb-16">
      <h2 class="text-[22px] font-extrabold text-ink">{product}</h2>
      <p class="mt-1 text-[15px] text-muted">{blurb}</p>
      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        {atlassianApps.filter((a) => a.product === product).map((a) => (
          <a href={`${base}/atlassian/${a.slug}`} class="card block">
            <h3 class="text-[17px] font-bold text-ink">{a.name}</h3>
            <p class="mt-1.5 text-[14.5px] leading-relaxed text-ink2">{a.tagline}</p>
            <span class="mt-3 inline-block text-[14px] font-semibold text-brand">Learn more &rarr;</span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="wrap pb-16 pt-12">
    <div class="rounded-2xl border border-line bg-soft px-8 py-8">
      <h2 class="text-[19px] font-bold text-ink">Also from Katabarwa Labs: 16 Azure apps.</h2>
      <p class="mt-2 max-w-[68ch] text-[15px] text-ink2">
        The same in-tenant model on Microsoft Azure: cost control, secret and certificate hygiene,
        backup coverage, and access governance, deployed as managed applications in your own
        subscription.
      </p>
      <a href={`${base}/azure`} class="mt-4 inline-block text-[14.5px] font-semibold text-brand">See the Azure apps &rarr;</a>
    </div>
  </section>
</Base>
