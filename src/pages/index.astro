---
import Base from '../layouts/Base.astro';
import { azureApps as azureAppData, azureBase } from '../data/azureApps';
import { withUtm, track } from '../lib/links';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const archetypes = [
  ['Audit-log retention & export', 'Keep compliance evidence past the platform’s short retention window.'],
  ['Orphaned-owner cleanup', 'Reclaim resources and seats left behind by people who’ve left.'],
  ['Access governance', 'Who can do what, permission drift, and audit-ready reports.'],
  ['Credential & certificate hygiene', 'Alert before secrets and certificates expire and break production.'],
  ['Cost, waste & coverage gaps', 'Find leaks, orphaned resources, and assets with no backup.'],
];
const marketplaces = [
  ['Microsoft Azure Marketplace', '16 apps live'],
  ['Atlassian Marketplace', '10 apps live'],
  ['Microsoft AppSource', 'in progress'],
  ['AWS Marketplace', 'in progress'],
];

const azureApps = azureAppData.map((a) => [a.name, a.blurb, a.slug] as [string, string, string]);

// Third element is the internal app-page path (deep dive + screenshots + demo),
// which carries the Try-it-free CTA to the Marketplace listing.
const atlassianApps: [string, string, string][] = [
  ['Access Governance Reporter', 'Who can access what in Jira, per user and per group, with audit CSV', '/atlassian/jira-access-governance-reporter'],
  ['Access Snapshot & Drift', 'Daily point-in-time project access snapshots, diffed for drift', '/atlassian/jira-access-snapshot-drift'],
  ['Compliance Log Vault', 'Long-term Jira audit log retention with CSV export', '/atlassian/jira-audit-log-retention'],
  ['Inactive-User Hygiene', 'Reclaim idle Jira seats from a read-only inactivity worklist', '/atlassian/jira-inactive-user-hygiene'],
  ['Orphaned-Owner Cleanup', 'Reassign filters, dashboards, and issues owned by deactivated users', '/atlassian/jira-orphaned-owner-cleanup'],
  ['Portal Governance for JSM', 'Per-desk portal access matrix with exposure flags', '/atlassian/jsm-portal-governance'],
  ['Notification Log for JSM', 'A record of every outgoing customer notification', '/atlassian/jsm-notification-log'],
  ['Assets Export Manager for JSM', 'Bulk-export a JSM Assets schema to CSV or JSON', '/atlassian/jsm-assets-export'],
  ['Attachment Cleanup for Confluence', 'Find unused and orphaned attachments, total reclaimable storage', '/atlassian/confluence-attachment-cleanup'],
  ['Page-Restriction Governance', 'Inventory every restricted Confluence page and who can reach it', '/atlassian/confluence-page-restriction-governance'],
];

const llmgraphFeatures = [
  'No-code visual canvas + natural-language workflow builder',
  'Grounds answers in your own docs (PDF, Word, Markdown)',
  'Six foundation models — Claude, Llama, Mistral, Amazon Nova',
  'Ships as a REST API and an embeddable chat widget at once',
];

const heroBg =
  'radial-gradient(1100px 460px at 78% -10%, #3a5bd9 0%, transparent 60%),' +
  'radial-gradient(760px 420px at 8% 0%, #16b6a6 0%, transparent 55%),' +
  'linear-gradient(160deg,#0a1636 0%,#122a63 58%,#20408f 100%)';
---
<Base
  title="Katabarwa Labs | in-tenant Atlassian and Azure apps, and the LLMGraph AI platform"
  description="Katabarwa Labs is a software company that designs and operates its own products: LLMGraph, a no-code platform for building AI support agents from your docs, and a portfolio of in-tenant operational tools across the Azure, AWS, and Atlassian marketplaces."
>
  <!-- hero -->
  <section class="relative overflow-hidden text-[#eaf0ff]" style={`background:${heroBg}`}>
    <div class="grid-overlay pointer-events-none absolute inset-0 opacity-50"></div>
    <div class="wrap relative z-10 pt-[86px] pb-[92px]">
      <span class="eyebrow">Katabarwa Labs</span>
      <h1 class="mt-4 max-w-[18ch] text-[clamp(30px,5vw,50px)] font-extrabold leading-[1.08] tracking-[-0.02em] text-white">
        A software company building focused products.
      </h1>
      <p class="mt-[18px] max-w-[62ch] text-[clamp(17px,2.3vw,20px)] leading-relaxed text-[#c8d6f7]">
        We design, ship, and operate our own software — from <b class="font-semibold text-white">LLMGraph</b>,
        a no-code platform for building AI support agents from your docs, to a portfolio of operational
        tools that run inside your own cloud, billed by the Azure, AWS, and Atlassian marketplaces.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#products" class="btn btn-primary">See our products</a>
        <a href="mailto:support@llmgraph.ai" class="btn btn-ghost">Talk to us</a>
      </div>
      <div class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[14px] text-[#a9bce6]">
        {['Built and operated in-house', 'AI platform + marketplace apps', 'Enterprise-ready'].map((t) => (
          <span class="flex items-center gap-2.5"><span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span><b class="font-semibold text-[#dfe8fb]">{t}</b></span>
        ))}
      </div>
    </div>
  </section>

  <!-- products -->
  <section id="products" class="border-b border-line py-[66px]">
    <div class="wrap">
      <span class="eyebrow">Our products</span>
      <h2 class="mt-2 text-[clamp(23px,3.2vw,30px)] font-extrabold tracking-[-0.02em]">Two lines, one company.</h2>
      <p class="mt-3 max-w-[64ch] text-[17px] text-muted">
        Katabarwa Labs owns and runs each product end-to-end — an AI application platform and a growing
        catalog of operational tools on the marketplaces enterprises already buy from.
      </p>
      <div class="mt-[34px] grid grid-cols-1 gap-6 lg:grid-cols-2">
        <!-- LLMGraph -->
        <div class="card flex flex-col">
          <span class="inline-flex w-fit items-center gap-2 rounded-full bg-brandsoft px-3 py-1 text-[12.5px] font-semibold uppercase tracking-[0.1em] text-brand">AI platform</span>
          <h3 class="mt-4 text-[22px] font-extrabold tracking-[-0.01em]">LLMGraph</h3>
          <p class="mt-2 text-[15.5px] leading-relaxed text-muted">
            Build customer-support chatbots and AI agents from your docs — no code required. Design a
            workflow on a visual canvas, ground it in your content, and go from idea to a deployed REST
            API and chat widget in minutes.
          </p>
          <ul class="mt-4 space-y-2">
            {llmgraphFeatures.map((f) => (
              <li class="flex items-start gap-2.5 text-[14.5px] text-ink2">
                <svg class="mt-0.5 shrink-0 text-brand" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <div class="mt-6 flex flex-wrap gap-3 pt-1">
            <a href="https://llmgraph.ai" class="btn btn-primary" target="_blank" rel="noopener">Visit llmgraph.ai</a>
          </div>
        </div>
        <!-- Marketplace apps -->
        <div class="card flex flex-col">
          <span class="inline-flex w-fit items-center gap-2 rounded-full bg-brandsoft px-3 py-1 text-[12.5px] font-semibold uppercase tracking-[0.1em] text-brand">Marketplace apps</span>
          <h3 class="mt-4 text-[22px] font-extrabold tracking-[-0.01em]">In-tenant operational tools</h3>
          <p class="mt-2 text-[15.5px] leading-relaxed text-muted">
            Small, single-purpose apps that deploy entirely inside your own cloud or SaaS tenant — no
            vendor backend, nothing leaves your environment — billed flat-rate by the marketplace you
            already use. One shape, ported across every enterprise platform.
          </p>
          <ul class="mt-4 space-y-2">
            {['Runs in your environment, read-only by default', 'No vendor backend — we host and store nothing', 'Flat, predictable pricing billed by the marketplace', 'Live and rolling out across four marketplaces'].map((f) => (
              <li class="flex items-start gap-2.5 text-[14.5px] text-ink2">
                <svg class="mt-0.5 shrink-0 text-brand" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <div class="mt-6 flex flex-wrap gap-3 pt-1">
            <a href="#apps" class="btn btn-line">Explore the portfolio</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- how it works -->
  <section id="how" class="border-b border-line py-[66px]">
    <div class="wrap">
      <span class="eyebrow">How the marketplace apps work</span>
      <h2 class="mt-2 text-[clamp(23px,3.2vw,30px)] font-extrabold tracking-[-0.02em]">The tool runs where your data already lives.</h2>
      <p class="mt-3 max-w-[64ch] text-[17px] text-muted">
        One idea, applied on every enterprise marketplace: deploy into the customer’s own environment
        and let the marketplace handle billing. We operate no servers, so “nothing leaves your tenant”
        is literally true — exactly what your security review wants to hear.
      </p>
      <div class="mt-[34px] grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <div class="card">
          <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg></div>
          <h3 class="text-[16.5px] font-bold">Runs in your environment</h3>
          <p class="mt-1.5 text-[14.5px] leading-relaxed text-muted">A serverless function or managed package deploys into your own subscription, account, or instance under an identity you control — read-only by default.</p>
        </div>
        <div class="card">
          <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/></svg></div>
          <h3 class="text-[16.5px] font-bold">No vendor backend</h3>
          <p class="mt-1.5 text-[14.5px] leading-relaxed text-muted">We host nothing and receive none of your operational data. Alerts go only to the Slack, Teams, or email endpoint you configure. Remove the app and every trace is gone.</p>
        </div>
        <div class="card">
          <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 13.5l-7 7-9.5-9.5V4h7z"/><path d="M7.5 8h.01"/></svg></div>
          <h3 class="text-[16.5px] font-bold">Flat, predictable pricing</h3>
          <p class="mt-1.5 text-[14.5px] leading-relaxed text-muted">The marketplace bills one flat price and pays us — no metering surprises, no invoicing, and no separate contract to negotiate.</p>
        </div>
        <div class="card">
          <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3.5"/></svg></div>
          <h3 class="text-[16.5px] font-bold">One job, done well</h3>
          <p class="mt-1.5 text-[14.5px] leading-relaxed text-muted">Focused tools that solve a single recurring admin pain — and prove their value the first time they fire.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- what we cover -->
  <section id="coverage" class="border-b border-line py-[66px]">
    <div class="wrap">
      <span class="eyebrow">What we cover</span>
      <h2 class="mt-2 text-[clamp(23px,3.2vw,30px)] font-extrabold tracking-[-0.02em]">The same handful of pains, on every platform.</h2>
      <p class="mt-3 max-w-[64ch] text-[17px] text-muted">We build each once and port the shape across marketplaces.</p>
      <div class="mt-[30px] overflow-hidden rounded-2xl border border-line bg-white">
        {archetypes.map(([k, v], i) => (
          <div class={`grid grid-cols-1 gap-x-5 gap-y-1 px-[22px] py-[18px] sm:grid-cols-[240px_1fr] ${i > 0 ? 'border-t border-line' : ''}`}>
            <div class="font-bold text-ink">{k}</div>
            <div class="text-[15px] text-muted">{v}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- live apps -->
  <section id="apps" class="border-b border-line py-[66px]">
    <div class="wrap">
      <span class="eyebrow">Live today</span>
      <h2 class="mt-2 text-[clamp(23px,3.2vw,30px)] font-extrabold tracking-[-0.02em]">{azureApps.length + atlassianApps.length} apps you can install right now.</h2>
      <p class="mt-3 max-w-[64ch] text-[17px] text-muted">
        Every link below goes to a live marketplace listing. Each app installs into your own tenant
        and is billed by the marketplace.
      </p>

      <h3 class="mt-9 text-[13px] font-semibold uppercase tracking-[0.1em] text-muted">Microsoft Azure Marketplace · {azureApps.length} apps</h3>
      <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {azureApps.map(([name, blurb, slug]) => (
          <a href={withUtm(azureBase + slug, slug, 'home-azure-card')} {...track('azure', slug, 'home-azure-card')} target="_blank" rel="noopener" class="group rounded-xl border border-line bg-white px-4 py-3.5 transition hover:border-brand">
            <div class="flex items-center justify-between gap-2">
              <span class="font-bold text-ink group-hover:text-brand">{name}</span>
              <svg class="shrink-0 text-muted group-hover:text-brand" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg>
            </div>
            <p class="mt-1 text-[13.5px] leading-snug text-muted">{blurb}</p>
          </a>
        ))}
      </div>

      <h3 class="mt-9 text-[13px] font-semibold uppercase tracking-[0.1em] text-muted">Atlassian Marketplace · {atlassianApps.length} apps</h3>
      <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {atlassianApps.map(([name, blurb, url]) => (
          <a href={`${base}${url}`} class="group rounded-xl border border-line bg-white px-4 py-3.5 transition hover:border-brand">
            <div class="flex items-center justify-between gap-2">
              <span class="font-bold text-ink group-hover:text-brand">{name}</span>
              <svg class="shrink-0 text-muted group-hover:text-brand" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg>
            </div>
            <p class="mt-1 text-[13.5px] leading-snug text-muted">{blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- marketplaces -->
  <section id="marketplaces" class="border-b border-line py-[66px]">
    <div class="wrap">
      <span class="eyebrow">Where to find us</span>
      <h2 class="mt-2 text-[clamp(23px,3.2vw,30px)] font-extrabold tracking-[-0.02em]">Rolling out across the marketplaces you already buy from.</h2>
      <div class="mt-7 flex flex-wrap gap-3">
        {marketplaces.map(([m, status]) => (
          <span class="inline-flex items-center gap-2.5 rounded-full border border-line bg-soft px-[18px] py-2.5 text-[14.5px] font-semibold text-ink2">{m}<span class="font-normal text-muted">· {status}</span></span>
        ))}
      </div>
    </div>
  </section>

  <!-- contact -->
  <section class="bg-soft">
    <div class="wrap flex flex-wrap items-center justify-between gap-5 py-11">
      <div>
        <h2 class="text-[24px] font-extrabold tracking-[-0.02em]">Have a pain worth productizing?</h2>
        <p class="mt-1.5 text-muted">Tell us the admin chore you keep re-solving — it’s probably our next app.</p>
      </div>
      <a href="mailto:support@llmgraph.ai" class="btn btn-primary">Email us</a>
    </div>
  </section>
</Base>
