---
import Base from './Base.astro';
import type { AtlassianApp } from '../data/atlassianApps';
import { withUtm, track } from '../lib/links';
import { asset, breadcrumbs, softwareApp, faq, ATLASSIAN } from '../lib/seo';

interface Props { app: AtlassianApp; }
const { app } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (n: number) => `${base}/apps/${app.slug}/h${n}.png`;
const path = `/atlassian/${app.slug}`;
const shots = [1, 2, 3].map((n) => asset(`/apps/${app.slug}/h${n}.png`));
// GA4 `app` and utm_campaign use the Marketplace listing slug so the app page,
// the blog posts, and the hub all attribute clicks to the same product id.
const listingSlug = new URL(app.listing).pathname.split('/').pop() ?? app.slug;
const listing = withUtm(app.listing, listingSlug, 'app-page-hero');
const listingFooter = withUtm(app.listing, listingSlug, 'app-page-footer');
const docs = withUtm(app.docs, listingSlug, 'app-page-docs');
const jsonLd = [
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Atlassian apps', path: '/atlassian' }, { name: app.name, path }]),
  softwareApp({ path, name: app.name, description: app.description, product: app.product, listing: app.listing, docs: app.docs, screenshots: shots, readOnly: !app.writes }),
  faq([
    { q: 'Does any data leave my instance?', a: 'No. The app runs on Atlassian Forge inside your own tenant with zero external egress, which makes it eligible for the Runs on Atlassian trust marker.' },
    { q: 'How is it billed?', a: 'Through the Atlassian Marketplace, on your existing Atlassian bill, priced per user like any Cloud app. The listing has a free evaluation and the exact calculator for your tier.' },
    { q: 'Where do I get support?', a: 'Email support@llmgraph.ai or open an issue from the documentation page. You talk directly to the people who build the app.' },
  ]),
];
const trust = [
  { label: 'Runs on Atlassian', href: ATLASSIAN.runsOnAtlassian, title: 'Atlassian program for apps with no external data egress' },
  { label: 'Built on Forge', href: ATLASSIAN.forge, title: 'Atlassian Forge developer platform' },
  { label: 'Atlassian Marketplace Partner', href: ATLASSIAN.vendorPage, title: 'Katabarwa Labs on the Atlassian Marketplace' },
  { label: 'Marketplace security review', href: ATLASSIAN.securityWorkflow, title: 'Every app passes the Marketplace app approval security workflow' },
];
---
<Base title={`${app.title} | ${app.name} by Katabarwa Labs`} description={app.description} ogImage={shots[0]} ogType="product" jsonLd={jsonLd}>
  <!-- hero -->
  <section class="bg-[linear-gradient(160deg,#0a1636,#152f6b)] text-[#eaf0ff]">
    <div class="wrap pt-[56px] pb-[52px]">
      <a href={`${base}/atlassian`} class="text-[13px] font-semibold uppercase tracking-[0.14em] text-accent hover:text-white">
        &larr; All Atlassian apps
      </a>
      <p class="mt-4 text-[13px] font-semibold uppercase tracking-[0.14em] text-[#a9bce6]">{app.product} · {app.name}</p>
      <h1 class="mt-2 max-w-[820px] text-[clamp(26px,4vw,40px)] font-extrabold leading-[1.12] tracking-[-0.02em] text-white">
        {app.title}
      </h1>
      <p class="mt-4 max-w-[62ch] text-[17px] leading-relaxed text-[#c8d6f7]">{app.tagline}</p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href={listing} target="_blank" rel="noopener" class="btn btn-primary" {...track('atlassian', listingSlug, 'app-page-hero')}>Try it free on the Atlassian Marketplace</a>
        <a href={docs} target="_blank" rel="noopener" class="btn btn-ghost" {...track('atlassian', listingSlug, 'app-page-docs')}>Documentation</a>
      </div>
      <p class="mt-4 text-[13px] text-[#a9bce6]">Runs entirely on Atlassian Forge inside your own tenant. No external servers, no data egress.</p>
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Trust marks">
        {trust.map((t) => (
          <li><a href={t.href} title={t.title} target="_blank" rel="noopener" class="inline-block rounded-full border border-white/25 px-3 py-1 text-[12.5px] font-semibold text-[#dfe8fb] hover:border-white hover:text-white">{t.label}</a></li>
        ))}
      </ul>
    </div>
  </section>

  {app.origin && (
    <section class="wrap pt-12">
      <span class="eyebrow">Why it exists</span>
      <p class="mt-3 max-w-[72ch] text-[17px] leading-relaxed text-ink2">
        This app answers a request that has been open on Atlassian's public tracker for years:
        <a class="font-semibold text-brand" href={`https://jira.atlassian.com/browse/${app.origin.ticket}`} target="_blank" rel="noopener">{app.origin.ticket}</a>,
        "{app.origin.title}", with {app.origin.votes}.
        {app.community && (
          <> We wrote up the problem and the native workarounds on <a class="font-semibold text-brand" href={app.community} target="_blank" rel="noopener">Atlassian Community</a>.</>
        )}
      </p>
    </section>
  )}

  <!-- problem -->
  <section class="wrap pt-12">
    <span class="eyebrow">The gap</span>
    <p class="mt-3 max-w-[72ch] text-[17px] leading-relaxed text-ink2">{app.problem}</p>
  </section>

  <!-- features + screenshots -->
  <section class="wrap pt-10">
    <span class="eyebrow">What it does</span>
    <ul class="mt-4 max-w-[72ch] list-disc space-y-2 pl-6 text-[16px] text-ink2">
      {app.features.map((f) => <li>{f}</li>)}
    </ul>

    <div class="mt-10 space-y-10">
      {[1, 2, 3].map((n) => (
        <figure class="overflow-hidden rounded-2xl border border-line bg-soft">
          <img src={img(n)} alt={app.captions[n - 1]} loading={n === 1 ? 'eager' : 'lazy'} class="w-full" width="920" height="450" />
          <figcaption class="border-t border-line px-5 py-3 text-[14px] text-muted">{app.captions[n - 1]}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  {app.youtube && (
    <section class="wrap pt-12">
      <span class="eyebrow">60-second walkthrough</span>
      <div class="mt-4 overflow-hidden rounded-2xl border border-line" style="aspect-ratio:16/9">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${app.youtube}`}
          title={`${app.name} demo video`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="h-full w-full"
        ></iframe>
      </div>
    </section>
  )}

  <!-- honest limits -->
  <section class="wrap pt-12">
    <span class="eyebrow">Honest about its limits</span>
    <ul class="mt-4 max-w-[72ch] list-disc space-y-2 pl-6 text-[16px] text-ink2">
      {app.honest.map((h) => <li>{h}</li>)}
      {app.writes && <li><strong>The one write path, honestly scoped:</strong> {app.writes}</li>}
      {!app.writes && <li><strong>Read-only.</strong> This app reports and exports; it changes nothing in your instance.</li>}
    </ul>
  </section>

  <!-- security / scopes -->
  <section class="wrap pt-12">
    <span class="eyebrow">Security &amp; permissions</span>
    <p class="mt-3 max-w-[72ch] text-[16px] text-ink2">
      Built on <a class="font-semibold text-brand" href={ATLASSIAN.forge} target="_blank" rel="noopener">Atlassian Forge</a>: the app runs on Atlassian's own serverless platform inside your
      tenant, stores its data in Forge storage, and makes no external network calls. Every scope it
      requests, and why:
    </p>
    <div class="mt-4 max-w-[760px] overflow-hidden rounded-xl border border-line">
      <table class="w-full text-[15px]">
        <tbody>
          {app.scopes.map((s) => (
            <tr class="border-b border-line last:border-0">
              <td class="bg-soft px-4 py-2.5 font-mono text-[13.5px] text-ink">{s.scope}</td>
              <td class="px-4 py-2.5 text-ink2">{s.why}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {app.atlassianDocs && (
    <section class="wrap pt-12">
      <span class="eyebrow">The native feature it builds on</span>
      <p class="mt-3 max-w-[72ch] text-[16px] text-ink2">Atlassian's own documentation for what {app.product} does out of the box, so you can see exactly where the gap is:</p>
      <ul class="mt-3 max-w-[72ch] list-disc space-y-1.5 pl-6 text-[16px]">
        {app.atlassianDocs.map((d) => <li><a class="font-semibold text-brand" href={d.url} target="_blank" rel="noopener">{d.label}</a> <span class="text-muted">(support.atlassian.com)</span></li>)}
      </ul>
    </section>
  )}

  <!-- FAQ -->
  <section id="support" class="wrap pt-12">
    <span class="eyebrow">FAQ</span>
    <div class="mt-4 max-w-[72ch] space-y-5">
      <div>
        <h3 class="text-[16px] font-bold text-ink">Does any data leave my instance?</h3>
        <p class="mt-1 text-[16px] text-ink2">
          No. The app runs on Atlassian Forge inside your own tenant with zero external egress,
          which makes it eligible for Atlassian's <a class="font-semibold text-brand" href={ATLASSIAN.runsOnAtlassian} target="_blank" rel="noopener">Runs on Atlassian</a> trust marker.
        </p>
      </div>
      <div>
        <h3 class="text-[16px] font-bold text-ink">How is it billed?</h3>
        <p class="mt-1 text-[16px] text-ink2">
          Through the Atlassian Marketplace, on your existing Atlassian bill, priced per user like
          any Cloud app. The listing has a free evaluation and the exact calculator for your tier.
        </p>
      </div>
      <div>
        <h3 class="text-[16px] font-bold text-ink">Where do I get support?</h3>
        <p class="mt-1 text-[16px] text-ink2">
          Email <a class="text-brand" href="mailto:support@llmgraph.ai">support@llmgraph.ai</a> or
          open an issue from the <a class="text-brand" href={app.docs} target="_blank" rel="noopener">documentation page</a>.
          You talk directly to the people who build the app.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="wrap py-14">
    <div class="rounded-2xl bg-[linear-gradient(160deg,#0a1636,#152f6b)] px-8 py-10 text-center">
      <h2 class="text-[24px] font-extrabold text-white">Install {app.name} in about a minute.</h2>
      <p class="mx-auto mt-2 max-w-[52ch] text-[15px] text-[#c8d6f7]">
        Free evaluation from the Marketplace listing. If it does not fit your workflow, tell us what
        would and we will build it.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={listingFooter} target="_blank" rel="noopener" class="btn btn-primary" {...track('atlassian', listingSlug, 'app-page-footer')}>Try it free</a>
        {app.blog && <a href={`${base}${app.blog}`} class="btn btn-ghost">Read the deep-dive</a>}
      </div>
    </div>
  </section>
</Base>
