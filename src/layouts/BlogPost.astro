---
import Base from './Base.astro';
import { blogPosting, breadcrumbs, isoDate, asset } from '../lib/seo';
import { bySlug } from '../data/atlassianApps';

interface Props {
  title: string;        // SEO <title> and H1
  description: string;  // meta description
  pubDate: string;      // e.g. "August 26, 2026"
  tag?: string;         // small eyebrow label, e.g. "Azure cost management"
  readMins?: number;
  image?: string;       // site-relative path under public/, used for og:image and BlogPosting.image
  community?: string;   // URL of the matching Atlassian Community App Central article, if one exists
  app?: string;         // site slug of the Atlassian app this post is about; renders the references block
}
const { title, description, pubDate, tag = 'Azure', readMins, image, community, app } = Astro.props;
const rec = app ? bySlug[app] : undefined;
const communityUrl = community ?? rec?.community;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
const published = isoDate(pubDate);
const jsonLd = [
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }, { name: title, path }]),
  blogPosting({ path, title, description, isoDate: published, tag, image: image ? asset(image) : undefined }),
];
---
<Base title={`${title} | Katabarwa Labs`} description={description} ogType="article" publishedTime={published} jsonLd={jsonLd} ogImage={image ? asset(image) : undefined}>
  <section class="bg-[linear-gradient(160deg,#0a1636,#152f6b)] text-[#eaf0ff]">
    <div class="wrap pt-[52px] pb-[44px]">
      <a href={`${base}/blog`} class="text-[13px] font-semibold uppercase tracking-[0.14em] text-accent hover:text-white">
        &larr; Blog
      </a>
      <h1 class="mt-3 max-w-[820px] text-[clamp(26px,4vw,38px)] font-extrabold leading-[1.12] tracking-[-0.02em] text-white">
        {title}
      </h1>
      <p class="mt-3 text-[14px] text-[#a9bce6]">
        {tag} · {pubDate}{readMins ? ` · ${readMins} min read` : ''}
      </p>
    </div>
  </section>

  <main class="prose-page mx-auto max-w-[760px] px-6 pt-10 pb-[72px]">
    <slot />

    {rec && (
      <aside class="mt-10 rounded-2xl border border-line bg-soft px-6 py-5">
        <h2 class="text-[15px] font-bold uppercase tracking-[0.08em] text-ink">References</h2>
        <ul class="mt-3 space-y-1.5 text-[15px] text-ink2">
          {rec.origin && <li>The request on Atlassian's tracker: <a class="font-semibold text-brand" href={`https://jira.atlassian.com/browse/${rec.origin.ticket}`} target="_blank" rel="noopener">{rec.origin.ticket}</a>, {rec.origin.title} ({rec.origin.votes}).</li>}
          {rec.atlassianDocs?.map((d) => <li>Atlassian documentation: <a class="font-semibold text-brand" href={d.url} target="_blank" rel="noopener">{d.label}</a>.</li>)}
          <li>The app: <a class="font-semibold text-brand" href={`${base}/atlassian/${rec.slug}`}>{rec.name}</a>, and its <a class="font-semibold text-brand" href={rec.listing} target="_blank" rel="noopener">Atlassian Marketplace listing</a>.</li>
        </ul>
      </aside>
    )}
    {communityUrl && (
      <p class="mt-8 rounded-xl border border-line bg-soft px-5 py-4 text-[15px] text-ink2">
        A version of this piece also appears on Atlassian Community:
        <a class="font-semibold text-brand" href={communityUrl} target="_blank" rel="noopener">read it on App Central</a>.
      </p>
    )}
    <hr class="my-10 border-line" />
    <p class="text-[14px] text-muted">
      Written by the team at <a class="text-brand" href={`${base}/`}>Katabarwa Labs</a>.
      We build small, single-purpose Atlassian and Azure tools that run entirely inside your own tenant.
      Questions: <a class="text-brand" href="mailto:support@llmgraph.ai">support@llmgraph.ai</a>.
    </p>
  </main>
</Base>
