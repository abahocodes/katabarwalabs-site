---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { canonical, asset, organization, website, ORG_NAME } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Absolute URL of the social image. Defaults to the site card. */
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  /** Extra JSON-LD nodes for this page; Organization and WebSite are always included. */
  jsonLd?: object[];
  /** ISO date for og:article:published_time on posts. */
  publishedTime?: string;
}
const { title, description, ogImage = asset('/og/default.png'), ogType = 'website', jsonLd = [], publishedTime } = Astro.props;
const url = canonical(Astro.url.pathname);
const graph = { '@context': 'https://schema.org', '@graph': [organization(), website(), ...jsonLd] };
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3E%3Crect width='30' height='30' rx='8' fill='%233b5bdb'/%3E%3Cg fill='white'%3E%3Crect x='8' y='16' width='3.4' height='6' rx='1.4'/%3E%3Crect x='13.3' y='12' width='3.4' height='10' rx='1.4'/%3E%3Crect x='18.6' y='8' width='3.4' height='14' rx='1.4'/%3E%3C/g%3E%3C/svg%3E";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:site_name" content={ORG_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={favicon} />
    <link rel="apple-touch-icon" href={asset('/logo-512.png')} />
    <link rel="sitemap" type="application/xml" href={asset('/sitemap.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-F6YRQHRQSF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-F6YRQHRQSF');
      // Outbound marketplace and docs links carry data-track attributes (see
      // src/lib/links.ts). One delegated listener turns them into a GA4 event
      // with app / marketplace / placement params. Register those three as
      // custom dimensions in GA4 to break reports down by them.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[data-track]') : null;
        if (!a) return;
        gtag('event', a.getAttribute('data-track'), {
          marketplace: a.getAttribute('data-marketplace') || undefined,
          app: a.getAttribute('data-app') || undefined,
          placement: a.getAttribute('data-placement') || undefined,
          link_url: a.href,
          transport_type: 'beacon'
        });
      }, true);
    </script>
  </head>
  <body class="bg-white text-ink antialiased">
    <Header />
    <slot />
    <Footer />
  </body>
</html>
