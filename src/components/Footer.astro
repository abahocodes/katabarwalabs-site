---
import Logo from './Logo.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="bg-[#0b1430] text-[#b9c6e6]">
  <div class="wrap flex flex-wrap justify-between gap-7 py-11">
    <div class="max-w-[300px]">
      <a href={`${base}/`} class="mb-3 flex items-center gap-2.5 font-bold text-white">
        <Logo gid="ftr" />
        <span>Katabarwa&nbsp;Labs</span>
      </a>
      <p class="text-[14.5px] text-[#93a3c8]">A software company building focused products — the LLMGraph AI platform and a portfolio of in-tenant marketplace apps.</p>
    </div>
    <div>
      <h4 class="mb-3 text-[13px] font-semibold uppercase tracking-[0.12em] text-white">Products</h4>
      <a href="https://llmgraph.ai" target="_blank" rel="noopener" class="my-1.5 block text-[15px] text-[#c4d1ef] hover:text-white">LLMGraph</a>
      <a href={`${base}/#products`} class="my-1.5 block text-[15px] text-[#c4d1ef] hover:text-white">Marketplace apps</a>
      <a href={`${base}/#marketplaces`} class="my-1.5 block text-[15px] text-[#c4d1ef] hover:text-white">Where to find us</a>
    </div>
    <div>
      <h4 class="mb-3 text-[13px] font-semibold uppercase tracking-[0.12em] text-white">Company</h4>
      <a href={`${base}/privacy`} class="my-1.5 block text-[15px] text-[#c4d1ef] hover:text-white">Privacy policy</a>
      <a href={`${base}/support`} class="my-1.5 block text-[15px] text-[#c4d1ef] hover:text-white">Support</a>
      <a href="mailto:abaho@llmgraph.ai" class="my-1.5 block text-[15px] text-[#c4d1ef] hover:text-white">Contact</a>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="wrap py-[18px] text-[13.5px] text-[#8ea0c8]">© 2026 Katabarwa Labs Inc. All rights reserved.</div>
  </div>
</footer>
