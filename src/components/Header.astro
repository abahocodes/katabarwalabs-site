---
import Logo from './Logo.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // '' at root, '/katabarwalabs-site' on Pages
const links = [
  { href: `${base}/#products`, label: 'Products' },
  { href: `${base}/apps`, label: 'Atlassian apps' },
  { href: `${base}/azure`, label: 'Azure apps' },
  { href: `${base}/blog`, label: 'Blog' },
];
---
<header class="sticky top-0 z-20 border-b border-line bg-white/80 backdrop-blur-md backdrop-saturate-150">
  <div class="wrap flex h-16 items-center justify-between">
    <a href={`${base}/`} class="flex items-center gap-2.5 font-bold tracking-[-0.01em] text-ink">
      <Logo gid="hdr" />
      <span>Katabarwa&nbsp;Labs</span>
    </a>
    <nav class="flex items-center gap-6">
      {links.map((l) => (
        <a href={l.href} class="hidden text-[15px] font-medium text-ink2 hover:text-brand sm:inline">{l.label}</a>
      ))}
      <a href="mailto:abaho@llmgraph.ai" class="btn btn-line">Contact</a>
    </nav>
  </div>
</header>
