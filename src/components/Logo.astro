---
interface Props { gid?: string; size?: number; }
const { gid = 'kl', size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 30 30" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="rounded-[9px] shadow-[0_4px_12px_-4px_rgba(59,91,219,.55)]">
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5b7bff" />
      <stop offset="1" stop-color="#1b3aa8" />
    </linearGradient>
  </defs>
  <rect width="30" height="30" rx="8" fill={`url(#${gid})`} />
  <g fill="#fff">
    <rect x="8" y="16" width="3.4" height="6" rx="1.4" />
    <rect x="13.3" y="12" width="3.4" height="10" rx="1.4" />
    <rect x="18.6" y="8" width="3.4" height="14" rx="1.4" />
  </g>
</svg>
